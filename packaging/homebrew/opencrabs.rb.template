# typed: strict
# frozen_string_literal: true

# Formula template for the Homebrew tap (#924).
#
# This file is the source of truth. The tap repository
# (github.com/adolfousier/homebrew-opencrabs) is GENERATED from it by the
# update-tap job in release.yml — do not edit the formula there by hand, a
# release overwrites it.
#
# Placeholders are replaced at release time by
# scripts/render-homebrew-formula.sh: the version (without its leading v) and
# one sha256 per platform, read from the SHA256SUMS published with the release.
# They are not spelled out here because the renderer substitutes every
# occurrence, including ones inside comments.
#
# Homebrew verifies every archive against its sha256 and refuses to install on
# a mismatch, so a stale hash is a hard install failure rather than a silent
# fallback. That is why the hashes are generated from the artifacts the release
# actually shipped instead of being maintained by hand.
class Opencrabs < Formula
  desc "Autonomous, self-improving AI agent in a single Rust binary"
  homepage "https://opencrabs.com"
  version "@VERSION@"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/adolfousier/opencrabs/releases/download/v@VERSION@/opencrabs-v@VERSION@-macos-arm64.tar.gz"
      sha256 "@SHA_MACOS_ARM64@"
    end
    on_intel do
      url "https://github.com/adolfousier/opencrabs/releases/download/v@VERSION@/opencrabs-v@VERSION@-macos-amd64.tar.gz"
      sha256 "@SHA_MACOS_AMD64@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/adolfousier/opencrabs/releases/download/v@VERSION@/opencrabs-v@VERSION@-linux-arm64.tar.gz"
      sha256 "@SHA_LINUX_ARM64@"
    end
    on_intel do
      url "https://github.com/adolfousier/opencrabs/releases/download/v@VERSION@/opencrabs-v@VERSION@-linux-amd64.tar.gz"
      sha256 "@SHA_LINUX_AMD64@"
    end
  end

  def install
    bin.install "opencrabs"
    # RTK ships inside the same archive and OpenCrabs prepends it to supported
    # bash commands. Installing it alongside keeps the bundled copy on PATH;
    # if it is ever absent OpenCrabs downloads one on first use, so a missing
    # file here is not fatal.
    bin.install "rtk" if File.exist?("rtk")
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/opencrabs --version")
  end
end
